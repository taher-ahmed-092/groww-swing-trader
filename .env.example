# ================================================================
# groww-swing-trader — environment variables
# cp .env.example .env  then fill in your values.
# NEVER commit .env to git. It is in .gitignore.
# Paper mode works fine with all values empty.
# ================================================================

# ── Anthropic (powers all LLM agents, judge, and reflection) ───
# Get key: https://console.anthropic.com → API Keys → Create Key
# Pricing: pay-per-token. claude-sonnet-4 is ~$3/M input tokens.
# Estimated cost for 2-3 trades/week research: < $5/month.
ANTHROPIC_API_KEY=

# ── Groww Trading API ───────────────────────────────────────────
# Subscribe: https://groww.in/trade-api  (₹499 + GST / month)
# After subscribing, go to: groww.in/trade-api/docs → Authentication
# Generate your access token from the Groww developer portal.
# IMPORTANT: You must ALSO whitelist a static IP with Groww.
#   Without a static IP, all order placement API calls will be rejected.
#   Options: (a) get a static IP from your ISP, or (b) use a small
#   cloud VM (AWS/GCP t2.micro is free tier) and run from there.
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=

# ── Live trading switch ─────────────────────────────────────────
# Default: false (paper mode — logs trades but places no real orders)
# Set to true ONLY after paper trading shows consistent edge.
# Requires all Groww keys above AND a whitelisted static IP.
LIVE_TRADING_ENABLED=false

# ── Telegram (optional — for remote trade approval from your phone) ─────────
# Create a bot: search @BotFather on Telegram → /newbot → copy token
# Get your chat ID: send a message to @userinfobot
# Without this, paper-mode approvals auto-accept; live-mode falls back to CLI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Finnhub (free key, sign up at finnhub.io — 60 req/min) ────────────
# Provides: company news, insider transactions, earnings calendar,
# sentiment scores, earnings surprises. India stocks covered.
# Get key: finnhub.io → Register → copy API key from dashboard
FINNHUB_API_KEY=

# ── NewsAPI.org (free key — 100 req/day) ────────────────────────────────
# Global news from 100+ sources. Great for breaking news and politics.
# Get key: newsapi.org → Get API Key
NEWS_API_KEY=

# ── Paper demo mode ─────────────────────────────────────────────
# Auto-enables when ANTHROPIC_API_KEY is empty.
# Rule-based scoring for infrastructure testing.
PAPER_DEMO_MODE=false

# ── Reddit (optional — for social sentiment on stocks) ──────────────
# Free: create an app at reddit.com/prefs/apps (type: script)
# Without this, Reddit sentiment is skipped gracefully.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Optional overrides (defaults come from config/risk_limits.py) ─
# MAX_TRADE_VALUE_INR=500
# MIN_CONFIDENCE=0.80
